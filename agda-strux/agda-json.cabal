cabal-version:      3.16
name:               agda-json
version:            0.1.0.0
build-type:         Simple
data-files: test/resources/Example.agda

executable agda-json
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
    AgdaJsonl.Run
    AgdaJsonl.Extract
  build-depends:
      base >= 4.18 && < 5
    , Agda == 2.8.0
    , containers
    , filepath
    , directory
    , text
    , unordered-containers

  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns -O0


test-suite agda-json-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
      base >= 4.18 && < 5
    , aeson
    , bytestring
    , directory
    , filepath
    , process
    , text
    , tasty
    , tasty-hunit
  default-language: GHC2021
  ghc-options: -Wall
