-- Benchmark obligation: hard-group-commutator-subgroup
-- Difficulty: non-obvious
-- Source: Classical.Structures.Group.Commutator (element-level lemmas only) with Setoid.Subalgebras.Subuniverses (Sg)
-- Import stratum: novel
-- Strategy: normality: a conjugate of a commutator is a commutator, then induction over Sg; commutativity of the quotient: (x ∙ y) ⁻¹ ∙ (y ∙ x) is a commutator, hence a generator
--
-- The subgroup generated by the commutators is normal, and the quotient by it is commutative: for all x and y, (x ∙ y) ⁻¹ ∙ (y ∙ x) lies in it, which is the coset relation x ∙ y ∼ y ∙ x.
--
module Group-commutator-subgroup where

open import AgdaDojang.Debug

open import Data.Product                  using ( _,_ ; _×_ ; Σ-syntax ; proj₁ ; proj₂ )
open import Level                         using ( Level ; _⊔_ )
open import Relation.Binary               using ( Setoid )
open import Relation.Binary.Definitions   using ( _Respects_ )
open import Relation.Unary                using ( Pred ; _∈_ ; _⊆_ )

open import Classical.Structures.Group.Basic         using ( Group ; module Group-Op )
open import Classical.Structures.Group.Subgroups     using ( IsSubgroup )
open import Classical.Structures.Group.Conjugation   using ( module Conjugate )
open import Setoid.Algebras.Basic                    using ( 𝕌[_] ; 𝔻[_] )
open import Classical.Structures.Group.Commutator    using ( module Commutator )
open import Setoid.Subalgebras.Subuniverses          using ( Sg )

module _ {α ρ : Level} (𝒢 : Group α ρ) where
  private
    𝑮 = proj₁ 𝒢
    G = 𝕌[ 𝑮 ]
  open Setoid 𝔻[ 𝑮 ] using ( _≈_ )
  open Group-Op 𝒢 using ( _∙_ ; _⁻¹ )
  open Commutator 𝒢 using ( [_⸴_] )

  -- The ≈-saturated set of commutators, and the subgroup it generates.
  Commutators : Pred G (α ⊔ ρ)
  Commutators z = Σ[ x ∈ G ] Σ[ y ∈ G ] z ≈ [ x ⸴ y ]

  Derived : Pred G _
  Derived = Sg 𝑮 Commutators

  commutator-subgroup
    :  Conjugate.IsNormal 𝒢 Derived
    ×  (∀ x y → ((x ∙ y) ⁻¹ ∙ (y ∙ x)) ∈ Derived)
  commutator-subgroup = {!!}
