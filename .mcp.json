{
  "mcpServers": {
    "agda": {
      "command": "nix",
      "args": [
        "develop", ".#backend", "--command",
        "cabal", "run", "-v0", "agda-mcp", "--",
        "--agda-flags", "-i agda-dojang/agda --library-file=agda-dojang/agda/libraries -l agda-dojang -l standard-library"
      ],
      "cwd": "."
    }
  }
}
