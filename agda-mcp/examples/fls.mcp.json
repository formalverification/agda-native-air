{
  "mcpServers": {
    "agda": {
      "command": "/ABS/PATH/TO/agda-native-air/scripts/run-server.sh",
      "args": [
        "--cwd", "${PWD}",
        "--agda-bin", "/ABS/PATH/TO/agda-native-air/scripts/agda-for-flake.sh",
        "--agda-flags", "-i /ABS/PATH/TO/agda-native-air/agda-dojang/agda",
        "--timeout", "900",
        "--check-command", "/ABS/PATH/TO/agda-native-air/scripts/agda-for-flake.sh src/Ledger.lagda.md",
        "--check-timeout", "3600"
      ],
      "env": { "AGDA_FLAKE_ATTR": "fls-agdaWithPackages" }
    }
  }
}
