cabal-version: 3.0
-- | agda-mcp.cabal
--
-- File: agda-native-air/agda-mcp/agda-mcp.cabal
--
-- Description:
--   Cabal package definition for the agda-mcp MCP server.
--
--   v0.2.0 (M1-3): adds search tools (search_by_name, search_by_type,
--   get_dependencies) backed by an in-memory corpus index from agda-strux JSONL.
--   v0.1.0 (M1-2): four core proof-state tools over stdio transport.
--
--   Design note (GHC version):
--   The `mcp-server` Hackage library requires base >= 4.20 (GHC 9.10+), but
--   agda-strux pins GHC 9.8.2 for Agda-as-a-library compatibility.  Rather
--   than introduce a second GHC version, we implement a minimal MCP stdio
--   transport (~200 lines) in AgdaMCP.Server.  This covers the subset of MCP
--   we need (initialize, tools/list, tools/call) and can be swapped for the
--   Hackage library once GHC versions converge.
name:          agda-mcp
version:       0.2.0
synopsis:      MCP server for AI-assisted Agda proof development
description:
  An MCP (Model Context Protocol) server that wraps AgdaDojang to expose
  Agda's proof engine to frontier coding agents (Claude Code, Codex CLI,
  Cursor, etc.).  See README.md for the tool surface and architecture.
license:       Apache-2.0
license-file:  ../LICENSE
author:        William DeMeo
maintainer:    williamdemeo@gmail.com
category:      Development, Formal Methods
build-type:    Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities
               -Wincomplete-record-updates
               -Wincomplete-uni-patterns
               -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  exposed-modules:
    AgdaMCP.Server
    AgdaMCP.Types
    AgdaMCP.Agda
    AgdaMCP.Diagnostics
    AgdaMCP.Holes
    AgdaMCP.Path
    AgdaMCP.Project
    AgdaMCP.Gate
    AgdaMCP.Corpus
    AgdaMCP.Tools.CheckProject
    AgdaMCP.Tools.ProofState
    AgdaMCP.Tools.Search
  build-depends:
      base          >= 4.18 && < 5
    , aeson         >= 2.1  && < 3
    , bytestring    >= 0.11 && < 0.13
    , containers    >= 0.6  && < 0.8
    , directory     >= 1.3  && < 1.4
    , filepath      >= 1.4  && < 1.6
    , process       >= 1.6  && < 1.8
    , text          >= 2.0  && < 2.2
      -- unix: group-wide SIGTERM/SIGKILL escalation on timeout ('signalProcessGroup');
      -- 'System.Process.interruptProcessGroupOf' covers only SIGINT.
    , unix          >= 2.8  && < 2.9
    , vector        >= 0.12 && < 0.14

executable agda-mcp
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
      base          >= 4.18 && < 5
    , agda-mcp
    , text          >= 2.0  && < 2.2
      -- directory: 'setCurrentDirectory', for --cwd (issue #103).
    , directory
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite agda-mcp-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
      base          >= 4.18 && < 5
    , agda-mcp
    , aeson         >= 2.1
    , bytestring
    , containers    >= 0.6
    , text          >= 2.0
    , process       >= 1.6
    , directory
    , filepath
      -- unix: 'createNamedPipe', for the tier-1g case that a path naming a FIFO
      -- is refused rather than read (issue #101).
    , unix          >= 2.8  && < 2.9
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
